# Copy to .env and fill in. .env is gitignored — never commit the real values.

# Any OpenAI-compatible endpoint. Leave API_URL unset for OpenAI.
OPENAI_API_KEY=
API_URL=https://api.openai.com/v1/chat/completions
MODEL=gpt-4o-mini

# Where qualified leads land: Zapier catch hook, Make, n8n, or your own endpoint.
CRM_WEBHOOK=

PORT=8787
